#!/usr/bin/env bash
set -euo pipefail

echo "=================================================="
echo "     Uninstalling sh-scripts-linux toolkit"
echo "=================================================="

TARGET_DIR="$HOME/.local/bin"

SCRIPTS=(
ytvideo
vytvideo
ytaudio
showmeta
showlyrics
showformat
hide
unhide
update
upgrade
aria
exifpic
folders
insta
encrypt
insta_fallback.py
toolkit-help
update-scripts
toolkit-uninstall
lyrics.py
)

echo ""
echo "Removing scripts from $TARGET_DIR..."

for script in "${SCRIPTS[@]}"; do
    FILE="$TARGET_DIR/$script"
    if [ -f "$FILE" ]; then
        rm -f "$FILE"
        echo "  ✔ Removed $script"
    fi
done

echo ""
echo "Cleaning shell configuration..."

python3 - << 'EOF'
from pathlib import Path
import re

block_patterns = [
    r'\n?# sh-scripts-linux: Show system specs on startup\n(?:.*?\n)*?fi\n?',
    r'\n?# sh-scripts-linux: Startup system info\n(?:.*?\n)*?fi\n?',
    r'\n?# sh-scripts-linux: Smart History Search[^\n]*\n(?:bind[^\n]*\n)+',
    r'\n?# sh-scripts-linux: Zsh Autosuggestions\n(?:.*?\n)*?fi\n?',
    r'\n?# sh-scripts-linux toolkit PATH\nexport PATH="[^"]*\.local/bin:\$PATH"\n?',
    r'\n?# sh-scripts-linux toolkit PATH\n?',
    r'\n?# Cmd-Scripts PATH\n?',
]

for name in (".bashrc", ".zshrc"):
    rc = Path.home() / name
    if not rc.is_file():
        continue

    text = rc.read_text()
    for pat in block_patterns:
        text = re.sub(pat, '\n', text, flags=re.MULTILINE)

    text = re.sub(r'\n{3,}', '\n\n', text)
    if text and not text.endswith('\n'):
        text += '\n'

    rc.write_text(text)
EOF

echo "  ✔ Shell configuration cleaned"

echo ""
read -r -p "Remove yt-dlp, instaloader, and lyricsgenius? (y/n): " confirm

if [[ "$confirm" =~ ^([yY][eE][sS]|[yY])$ ]]; then
    if command -v pipx >/dev/null 2>&1; then
        pipx uninstall yt-dlp >/dev/null 2>&1 || true
        pipx uninstall instaloader >/dev/null 2>&1 || true
        echo "  ✔ Removed pipx packages (yt-dlp, instaloader)"
    fi

    if command -v pip3 >/dev/null 2>&1; then
        pip3 uninstall -y yt-dlp instaloader lyricsgenius >/dev/null 2>&1 \
            || pip3 uninstall -y --break-system-packages yt-dlp instaloader lyricsgenius >/dev/null 2>&1 \
            || true
        echo "  ✔ Cleaned pip3 packages if present"
    fi
fi

echo ""
read -r -p "Remove Deno (~/.deno and shell lines) if installed? (y/n): " remove_deno

if [[ "$remove_deno" =~ ^([yY][eE][sS]|[yY])$ ]]; then
    if [ -d "$HOME/.deno" ]; then
        rm -rf "$HOME/.deno"
        echo "  ✔ Removed ~/.deno directory"
    fi

    python3 - << 'EOF'
from pathlib import Path
import re

deno_markers = (".deno/env", "deno.bash", ".deno/bin", "DENO_INSTALL")

for name in (".bashrc", ".zshrc"):
    rc = Path.home() / name
    if not rc.is_file():
        continue
    lines = [
        line for line in rc.read_text().splitlines(keepends=True)
        if not any(marker in line for marker in deno_markers)
    ]
    text = re.sub(r'\n{3,}', '\n\n', "".join(lines))
    if text and not text.endswith('\n'):
        text += '\n'
    rc.write_text(text)
EOF
    echo "  ✔ Cleaned Deno shell entries"
fi

echo ""
echo "=================================================="
echo "✅ sh-scripts-linux toolkit uninstalled successfully"
echo "=================================================="
echo ""
echo "Restart your terminal or run:"
echo "  source ~/.bashrc  (or ~/.zshrc)"
