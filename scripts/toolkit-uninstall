#!/usr/bin/env bash
set -euo pipefail

echo "=================================================="
echo "     Uninstalling sh-scripts-linux toolkit"
echo "=================================================="

TARGET_DIR="$HOME/.local/bin"

# Complete script array matching install.sh
SCRIPTS=(
ytvideo
vytvideo
hytvideo
ytaudio
showmeta
showlyrics
showformat
hide
unhide
update
upgrade
aria
exifpic
folders
insta
encrypt
insta_fallback.py
toolkit-help
update-scripts
toolkit-uninstall
lyrics.py
)

# ===============================
# Remove scripts
# ===============================
echo ""
echo "Removing scripts from $TARGET_DIR..."

for script in "${SCRIPTS[@]}"; do
    FILE="$TARGET_DIR/$script"

    if [ -f "$FILE" ]; then
        rm -f "$FILE"
        echo "  ✔ Removed $script"
    fi
done

# ===============================
# Clean shell configuration
# ===============================
echo ""
echo "Cleaning shell configuration..."

for CONFIG in "$HOME/.bashrc" "$HOME/.zshrc"; do
    if [ -f "$CONFIG" ]; then
        # Remove PATH entries added by the toolkit
        sed -i '/# Cmd-Scripts PATH/d' "$CONFIG"
        sed -i '/# sh-scripts-linux toolkit PATH/d' "$CONFIG"
        sed -i '\|export PATH="\$HOME/.local/bin:\$PATH"|d' "$CONFIG"
        sed -i '\|export PATH="\$TARGET_DIR:\$PATH"|d' "$CONFIG"

        # Remove startup system info & shell enhancements added by install.sh
        sed -i '/# sh-scripts-linux: Startup system info/,/^fi$/d' "$CONFIG"
        sed -i '/# sh-scripts-linux: Smart History Search/,/history-search-forward/d' "$CONFIG"
        sed -i '/# sh-scripts-linux: Zsh Autosuggestions/,/^fi$/d' "$CONFIG"
    fi
done

echo "  ✔ Shell configuration cleaned"

# ===============================
# Remove pipx / pip packages (optional)
# ===============================
echo ""
read -r -p "Remove yt-dlp, instaloader, and lyricsgenius? (y/n): " confirm

if [[ "$confirm" =~ ^([yY][eE][sS]|[yY])$ ]]; then
    if command -v pipx >/dev/null 2>&1; then
        pipx uninstall yt-dlp >/dev/null 2>&1 || true
        pipx uninstall instaloader >/dev/null 2>&1 || true
        echo "  ✔ Removed pipx packages"
    else
        echo "  ⚠ pipx not found, skipping pipx removal."
    fi

    if command -v pip3 >/dev/null 2>&1; then
        pip3 uninstall -y lyricsgenius >/dev/null 2>&1 || true
        echo "  ✔ Removed lyricsgenius"
    fi
fi

# ===============================
# Done
# ===============================
echo ""
echo "=================================================="
echo "✅ sh-scripts-linux toolkit uninstalled successfully"
echo "=================================================="
echo ""
echo "Restart your terminal or run:"
echo "  source ~/.bashrc  (or ~/.zshrc)"
