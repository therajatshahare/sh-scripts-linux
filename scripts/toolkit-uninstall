#!/usr/bin/env bash
set -euo pipefail

echo "=================================================="
echo "     Uninstalling sh-scripts-linux toolkit"
echo "=================================================="

TARGET_DIR="$HOME/.local/bin"

# Complete script array matching the installer
SCRIPTS=(
ytvideo
vytvideo
ytaudio
showmeta
showlyrics
showformat
hide
unhide
update
upgrade
aria
exifpic
folders
insta
encrypt
insta_fallback.py
toolkit-help
update-scripts
toolkit-uninstall
lyrics.py
)

# ===============================
# Remove scripts
# ===============================
echo ""
echo "Removing scripts from $TARGET_DIR..."

for script in "${SCRIPTS[@]}"; do
    FILE="$TARGET_DIR/$script"

    if [ -f "$FILE" ]; then
        rm -f "$FILE"
        echo "  ✔ Removed $script"
    fi
done

# ===============================
# Remove PATH entry
# ===============================
echo ""
echo "Cleaning PATH configuration..."

for CONFIG in "$HOME/.bashrc" "$HOME/.zshrc"; do
    if [ -f "$CONFIG" ]; then
        # Remove both current and legacy signatures
        sed -i '/# Cmd-Scripts PATH/d' "$CONFIG"
        sed -i '/# sh-scripts-linux toolkit PATH/d' "$CONFIG"
        sed -i '\|.local/bin|d' "$CONFIG"
    fi
done

echo "  ✔ PATH configuration cleaned"

# ===============================
# Remove pipx packages (optional)
# ===============================
echo ""
read -r -p "Do you want to remove yt-dlp and instaloader installed via pipx? (y/n): " confirm

if [[ "$confirm" =~ ^([yY][eE][sS]|[yY])$ ]]; then
    if command -v pipx >/dev/null 2>&1; then
        pipx uninstall yt-dlp >/dev/null 2>&1 || true
        pipx uninstall instaloader >/dev/null 2>&1 || true
        echo "  ✔ Removed pipx packages"
    else
        echo "  ⚠ pipx not found, skipping package removal."
    fi
fi

# ===============================
# Done
# ===============================
echo ""
echo "=================================================="
echo "✅ sh-scripts-linux toolkit uninstalled successfully"
echo "=================================================="
echo ""
echo "Restart your terminal or run:"
echo "  source ~/.bashrc  (or ~/.zshrc)"
