#!/usr/bin/env bash
cat << 'EOF'
==================================================
           sh-scripts-linux toolkit
==================================================

  📥 Media & Archiving:
    ytvideo <url> [res] [name]  - Download video in MKV container (itags/codec prioritized)
    vytvideo <url> [res] [name] - Width-based vertical/horizontal video downloader
    hytvideo <url> [res] [name] - High-speed parallel fragment video downloader
    ytaudio <url>               - Extract lossless FLAC audio with cover art & lyrics prompt
    aria <url> [options]        - Fast multi-connection file downloader via aria2c
    showformat <url>            - List available yt-dlp formats for a video

  📱 Social Media & Utilities:
    insta <username> [full|update] - Download or fast-update Instagram profiles via instaloader
    encrypt <target> [enc/dec]  - Securely encrypt/decrypt files or folders using GPG AES-256
    folders                     - Organize current directory into structured category folders
    exifpic <date> [file]       - Batch or single image EXIF timestamp updater
    hide <file>                 - Hide a file/directory (dotfile prefix + read-only)
    unhide <file>               - Restore a hidden file/directory
    showmeta <file>             - Display media file metadata headers via ffmpeg
    showlyrics <file>           - Display embedded audio lyrics

  ⚙️ System & Maintenance:
    update                      - Refresh system package repository lists universally
    upgrade                     - Perform full system package upgrade universally
    update-scripts              - Pull and install the latest version of this toolkit
    toolkit-help                - Display this help manual
    toolkit-uninstall           - Remove toolkit binaries from system PATH

==================================================
EOF
