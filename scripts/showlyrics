#!/usr/bin/env bash
set -euo pipefail

# ===============================
# Argument
# ===============================
FILE="${1:-}"

# ===============================
# Validate input
# ===============================
if [ -z "$FILE" ]; then
    echo "Usage: showlyrics <file>"
    exit 1
fi

if [ ! -f "$FILE" ]; then
    echo "File not found: $FILE"
    exit 1
fi

# ===============================
# Check dependency universally
# ===============================
if ! command -v ffprobe >/dev/null 2>&1; then
    echo "Error: ffprobe is not installed or not found in PATH."
    echo "Please install ffmpeg using your package manager:"
    echo "  Ubuntu / Debian / Mint : sudo apt install ffmpeg"
    echo "  Fedora / RHEL / CentOS : sudo dnf install ffmpeg"
    echo "  Arch Linux / Manjaro   : sudo pacman -S ffmpeg"
    exit 1
fi

# ===============================
# Extract lyrics
# ===============================
lyrics=$(ffprobe -v error \
    -show_entries format_tags=lyrics \
    -of default=nw=1:nk=1 \
    "$FILE" 2>/dev/null || true)

# ===============================
# Output
# ===============================
if [ -n "$lyrics" ] && [ -n "$(echo "$lyrics" | tr -d '[:space:]')" ]; then
    echo "Lyrics:"
    echo "$lyrics"
else
    echo "No embedded lyrics found."
fi
