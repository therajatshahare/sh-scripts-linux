#!/usr/bin/env bash

echo "Detecting package manager..."

# ===============================
# Detect package manager
# ===============================
if command -v apt >/dev/null 2>&1; then
    PM="apt"
elif command -v dnf >/dev/null 2>&1; then
    PM="dnf"
elif command -v pacman >/dev/null 2>&1; then
    PM="pacman"
elif command -v zypper >/dev/null 2>&1; then
    PM="zypper"
elif command -v apk >/dev/null 2>&1; then
    PM="apk"
else
    echo "❌ Unsupported package manager."
    exit 1
fi

echo "Using package manager: $PM"
echo ""

# ===============================
# Run update (with exit code handling)
# ===============================
SUCCESS=0

case "$PM" in
    apt)
        sudo apt update
        SUCCESS=$?
        ;;
    dnf)
        sudo dnf check-update
        # DNF returns 100 when updates are available, which is a successful check
        EXIT_CODE=$?
        if [ $EXIT_CODE -eq 0 ] || [ $EXIT_CODE -eq 100 ]; then
            SUCCESS=0
        else
            SUCCESS=$EXIT_CODE
        fi
        ;;
    pacman)
        sudo pacman -Sy
        SUCCESS=$?
        ;;
    zypper)
        sudo zypper refresh
        SUCCESS=$?
        ;;
    apk)
        sudo apk update
        SUCCESS=$?
        ;;
esac

# ===============================
# Result
# ===============================
if [ $SUCCESS -eq 0 ]; then
    echo ""
    echo "✅ System package list updated successfully"
else
    echo ""
    echo "❌ Update failed"
    exit 1
fi
