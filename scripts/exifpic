#!/usr/bin/env bash
set -euo pipefail

# ===============================
# Arguments
# ===============================
DATETIME="$1"
FILE="${2:-}"

# ===============================
# Validate input
# ===============================
if [ -z "$DATETIME" ]; then
    echo 'Usage: exifpic "YYYY:MM:DD HH:MM"'
    echo 'Or:    exifpic "YYYY:MM:DD HH:MM" "filename.jpg"'
    exit 1
fi

# ===============================
# Check dependency universally
# ===============================
if ! command -v exiftool >/dev/null 2>&1; then
    echo "Error: exiftool is not installed or not found in PATH."
    echo "Please install exiftool using your package manager:"
    echo "  Ubuntu / Debian / Mint : sudo apt install libimage-exiftool-perl"
    echo "  Fedora / RHEL / CentOS : sudo dnf install perl-Image-ExifTool"
    echo "  Arch Linux / Manjaro   : sudo pacman -S perl-image-exiftool"
    echo "  openSUSE               : sudo zypper install perl-Image-ExifTool"
    echo "  Alpine Linux           : sudo apk add perl-image-exiftool"
    exit 1
fi

# ===============================
# Single file mode
# ===============================
if [ -n "$FILE" ]; then
    if [ ! -f "$FILE" ]; then
        echo "File not found: $FILE"
        exit 1
    fi

    echo "Updating timestamps for: $FILE"

    exiftool -overwrite_original \
        "-FileModifyDate=$DATETIME" \
        "-FileCreateDate=$DATETIME" \
        "$FILE"

    echo "✅ Done"
    exit 0
fi

# ===============================
# Batch mode (all images, case-insensitive)
# ===============================
shopt -s nullglob nocaseglob
files=( *.jpg *.jpeg *.png )

if [ ${#files[@]} -eq 0 ]; then
    echo "No JPG/PNG files found in current directory."
    exit 1
fi

echo "Updating timestamps for all images..."

for file in "${files[@]}"; do
    exiftool -overwrite_original \
        "-FileModifyDate=$DATETIME" \
        "-FileCreateDate=$DATETIME" \
        "$file"
done

echo "✅ Done"
