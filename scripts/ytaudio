#!/usr/bin/env bash
set -euo pipefail

# ===============================
# Check dependencies universally
# ===============================
if ! command -v yt-dlp >/dev/null 2>&1; then
    echo "Error: yt-dlp is not installed or not found in PATH."
    echo "Please install yt-dlp using your package manager:"
    echo "  Ubuntu / Debian / Mint : sudo apt install yt-dlp"
    echo "  Fedora / RHEL / CentOS : sudo dnf install yt-dlp"
    echo "  Arch Linux / Manjaro   : sudo pacman -S yt-dlp"
    exit 1
fi

if ! command -v ffmpeg >/dev/null 2>&1; then
    echo "Error: ffmpeg is not installed or not found in PATH."
    echo "Please install ffmpeg using your package manager:"
    echo "  Ubuntu / Debian / Mint : sudo apt install ffmpeg"
    echo "  Fedora / RHEL / CentOS : sudo dnf install ffmpeg"
    echo "  Arch Linux / Manjaro   : sudo pacman -S ffmpeg"
    exit 1
fi

# ===============================
# Usage check
# ===============================
if [ $# -eq 0 ]; then
    echo "Usage: ytaudio <URL> [options]"
    exit 1
fi

# ===============================
# Download and extract audio
# ===============================
echo "[*] Downloading and extracting lossless audio..."
yt-dlp \
    --extract-audio \
    --audio-format flac \
    --audio-quality 0 \
    -f bestaudio \
    --add-metadata \
    --embed-thumbnail \
    --postprocessor-args "ffmpeg:-compression_level 12" \
    -o "%(title)s.%(ext)s" \
    "$@"

# ===============================
# Fallback: convert leftover webm
# ===============================
shopt -s nullglob
for file in *.webm; do
    [ -e "$file" ] || continue

    output="${file%.webm}.flac"
    echo "[*] Converting leftover webm to FLAC: $file"
    ffmpeg -i "$file" -compression_level 12 -y "$output"
    rm "$file"
done

# ===============================
# Detect newest FLAC file
# ===============================
latest=$(ls -t *.flac 2>/dev/null | head -n 1 || true)

if [ -z "$latest" ]; then
    echo "❌ No FLAC file found."
    exit 1
fi

title="${latest%.flac}"

# ===============================
# Ask for lyrics
# ===============================
read -p "Do you want to add lyrics from Genius? (y/n): " answer

if [[ ! "$answer" =~ ^([yY][eE][sS]|[yY])$ ]]; then
    echo "✅ Audio ready: $latest"
    exit 0
fi

echo "Fetching lyrics for: $title"

# ===============================
# Run Python script
# ===============================
scriptDir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$scriptDir/lyrics.py" ]; then
    python3 "$scriptDir/lyrics.py" "$title" "$latest"
    echo "✅ Lyrics embedded into $latest"
else
    echo "❌ Error: lyrics.py not found in $scriptDir"
    exit 1
fi
