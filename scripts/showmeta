#!/usr/bin/env bash
set -euo pipefail

# ===============================
# Argument
# ===============================
FILE="${1:-}"

# ===============================
# Validate input
# ===============================
if [ -z "$FILE" ]; then
    echo "Usage: showmeta <file>"
    exit 1
fi

if [ ! -f "$FILE" ]; then
    echo "File not found: $FILE"
    exit 1
fi

# ===============================
# Check dependency universally
# ===============================
if ! command -v ffmpeg >/dev/null 2>&1; then
    echo "Error: ffmpeg is not installed or not found in PATH."
    echo "Please install ffmpeg using your package manager:"
    echo "  Ubuntu / Debian / Mint : sudo apt install ffmpeg"
    echo "  Fedora / RHEL / CentOS : sudo dnf install ffmpeg"
    echo "  Arch Linux / Manjaro   : sudo pacman -S ffmpeg"
    exit 1
fi

echo "Metadata for: $FILE"
echo "--------------------------"

# ===============================
# Get metadata
# (ffmpeg returns exit status 1 when no output file is provided; || true prevents set -e abort)
# ===============================
output=$(ffmpeg -hide_banner -i "$FILE" 2>&1 || true)

# ===============================
# Filter metadata lines
# ===============================
meta=$(echo "$output" | grep -E '^[[:space:]]+[a-zA-Z0-9_]+[[:space:]]*:' | grep -v "Stream" || true)

# ===============================
# Output
# ===============================
if [ -n "$meta" ] && [ -n "$(echo "$meta" | tr -d '[:space:]')" ]; then
    echo "$meta"
else
    echo "No metadata found."
fi
