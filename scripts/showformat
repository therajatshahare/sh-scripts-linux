#!/usr/bin/env bash
set -euo pipefail

# ===============================
# Argument
# ===============================
URL="${1:-}"

# ===============================
# Validate input
# ===============================
if [ -z "$URL" ]; then
    echo "Usage: showformat <url>"
    exit 1
fi

# ===============================
# Check dependency universally
# ===============================
if ! command -v yt-dlp >/dev/null 2>&1; then
    echo "Error: yt-dlp is not installed or not found in PATH."
    echo "Please install yt-dlp using your package manager:"
    echo "  Ubuntu / Debian / Mint : sudo apt install yt-dlp"
    echo "  Fedora / RHEL / CentOS : sudo dnf install yt-dlp"
    echo "  Arch Linux / Manjaro   : sudo pacman -S yt-dlp"
    exit 1
fi

# ===============================
# Show available formats
# ===============================
yt-dlp --list-formats "$URL"
